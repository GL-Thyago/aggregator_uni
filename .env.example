PORT=3010
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/casino_aggregator
REDIS_URL=redis://127.0.0.1:6380

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=admin_dev_key_change_me

GAMES_DIR=./games
PUBLIC_BASE_URL=http://localhost:3010
SALSA_PUBLISHER_URL=

SALSA_ENABLED=false
SALSA_GAME_LOGO=true
SALSA_PROVIDER_SCAN_MAX=250
SALSA_DEFAULT_COST_PCT=6.5

# Teste Salsa
SALSA_PN=rg-games-staging
SALSA_HASH_KEY=
SALSA_GAME_LIST_URL=https://back-test.patagoniaentertainment.com/game-integration.do?pn=rg-games-staging

# Produção Salsa (vazio até a Salsa enviar o PN live)
SALSA_PN_LIVE=
SALSA_HASH_KEY_LIVE=
SALSA_GAME_LIST_URL_LIVE=

# Wallet: não use env. Cadastre walletUrl no admin, por cliente.
