PORT=3010
NODE_ENV=development

# Docker: use `npm run docker:up` (postgres:16 + redis:7 on ports 5433/6380).
# If containers exit with "exec format error", avoid alpine images — already fixed in docker-compose.yml.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/casino_aggregator
REDIS_URL=redis://127.0.0.1:6380

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=admin_dev_key_change_me

# API Key do cliente demo (back_uni_fut) — use a mesma no .env do back_uni_fut
# CASINO_AGGREGATOR_API_KEY=ca_demo_back_uni_fut_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Pasta onde ficam os jogos proprietários (Construct 3, HTML5, etc.)
GAMES_DIR=./games

# URL pública do agregador (usada para montar launchUrl nos jogos)
PUBLIC_BASE_URL=http://localhost:3010
# URL que a Salsa chama no wallet (obrigatória em staging/prod — não pode ser localhost)
# Ex.: https://xxxx.trycloudflare.com/api/v1/salsa/publisher
SALSA_PUBLISHER_URL=

# ─── Integração Salsa (Publisher) ───────────────────────────────────────────
# Ative quando receber credenciais da Salsa Technology
SALSA_ENABLED=false
# Nome do publisher (pn) — fornecido pela Salsa
SALSA_PN=rg-games-staging
# Key para validar Hash sha256(ParamsValue + Key)
SALSA_HASH_KEY=c064b0e9ad5cd6e265b971d2a1a9e5db
# URL do JSON (sem provider=). Sempre pedimos gameLogo=true (na doc o default é false).
# A Salsa bloqueia um segundo download por 24h — o aggregator guarda cache em data/salsa-catalog-cache.json.
# Staging: https://back-test.patagoniaentertainment.com/game-integration.do?pn=rg-games-staging
# Produção: https://back.patagoniaentertainment.com/game-integration.do?pn=SEU_PN_PROD
SALSA_GAME_LIST_URL=https://back-test.patagoniaentertainment.com/game-integration.do?pn=rg-games-staging
SALSA_PROVIDER_SCAN_MAX=250
SALSA_GAME_LOGO=true
# Staging: https://api-test.salsagator.com | Produção: https://api.salsagator.com
# Tem de casar com o catálogo: back-test → api-test | back.patagonia → api.salsagator
SALSA_API_BASE=https://api-test.salsagator.com
# Custo padrão repasse Salsa Studio tier 1 (% GGR) — ajuste conforme contrato
SALSA_DEFAULT_COST_PCT=6.5
