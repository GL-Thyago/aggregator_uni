# Uni Aggregator — EasyPanel (produção)
# Copie estas variáveis para o serviço do aggregator. Não commite senhas.

NODE_ENV=production
PORT=3010

# Banco e Redis (os vossos hosts reais)
DATABASE_URL=postgresql://USER:SENHA@uni_bd_agregador:5432/uni
REDIS_URL=redis://SEU_REDIS:6379

JWT_SECRET=troque-para-um-segredo-longo-aleatorio-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=troque-esta-chave-admin

GAMES_DIR=./games
RUN_SEED=false

# Este servidor (não é o front, não é o wallet do cassino)
PUBLIC_BASE_URL=https://rggames.site
SALSA_PUBLISHER_URL=https://rggames.site/api/v1/salsa/publisher

SALSA_ENABLED=true
SALSA_GAME_LOGO=true
SALSA_PROVIDER_SCAN_MAX=250
SALSA_DEFAULT_COST_PCT=6.5

# ── TESTE (Salsa staging) ──────────────────────────────────────────
# Já têm isto. PN atual: rg-games-staging
SALSA_PN=rg-games-staging
SALSA_HASH_KEY=cole-o-hash-de-staging
SALSA_GAME_LIST_URL=https://back-test.patagoniaentertainment.com/game-integration.do?pn=rg-games-staging

# ── PRODUÇÃO (Salsa live) ──────────────────────────────────────────
# A Salsa envia PN e hash NOVOS. Sem isto, jogo live falha.
# rg-games-staging NÃO funciona em api.salsagator.com
SALSA_PN_LIVE=
SALSA_HASH_KEY_LIVE=
SALSA_GAME_LIST_URL_LIVE=https://back.patagoniaentertainment.com/game-integration.do?pn=

# Wallet NÃO vai neste .env.
# Cada cassino tem walletUrl + walletSecret no admin Uni (banco).
# SorteioBR: no cliente, walletUrl = https://b.sorteiobr.com/api/casino/wallet
