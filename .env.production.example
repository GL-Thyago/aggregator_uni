# Copie para .env.production no servidor (nunca commite senhas).
# cp .env.production.example .env.production

NODE_ENV=production
PORT=3010
POSTGRES_PASSWORD=troque-esta-senha-forte

JWT_SECRET=troque-para-um-segredo-longo-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=troque-esta-chave-admin

GAMES_DIR=./games

# Domínio público do aggregator (não é o front uni_cliente)
PUBLIC_BASE_URL=https://rggames.site
SALSA_PUBLISHER_URL=https://rggames.site/api/v1/salsa/publisher

SALSA_ENABLED=true
SALSA_PN=rg-games-staging
SALSA_HASH_KEY=
SALSA_GAME_LIST_URL=https://back-test.patagoniaentertainment.com/game-integration.do?pn=rg-games-staging
SALSA_API_BASE=https://api.salsagator.com
SALSA_DEFAULT_COST_PCT=6.5

# true só na primeira subida se o banco estiver vazio
RUN_SEED=false
