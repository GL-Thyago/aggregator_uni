# Copie para .env.production no servidor (nunca commite senhas).
# cp .env.production.example .env.production
#
# Salsa tem DOIS ambientes. Não misture.
#
#   STAGING (o que vocês têm hoje: PN rg-games-staging)
#     catálogo: https://back-test.patagoniaentertainment.com/game-integration.do?pn=rg-games-staging
#     launch:   https://api-test.salsagator.com
#
#   PRODUÇÃO (PN e Hash Key NOVOS, que a Salsa envia na virada)
#     catálogo: https://back.patagoniaentertainment.com/game-integration.do?pn=SEU_PN
#     launch:   https://api.salsagator.com
#
# rg-games-staging NÃO existe em back.patagoniaentertainment.com
# ("Non Existent Publisher Exception"). back-test NÃO é produção.

NODE_ENV=production
PORT=3010

# Senha do Postgres deste compose (docker-compose.prod.yml).
# Se o banco já é o da UNI (uni_bd_agregador / database uni), ignore POSTGRES_PASSWORD
# e preencha DATABASE_URL no compose/app com o host real.
POSTGRES_PASSWORD=troque-esta-senha-forte

# docker-compose.prod.yml sobrescreve estas duas para os serviços postgres/redis.
# Compose próprio (uni_bd_agregador), use por exemplo:
# DATABASE_URL=postgresql://USER:SENHA@uni_bd_agregador:5432/uni
# REDIS_URL=redis://SEU_REDIS:6379
DATABASE_URL=postgresql://postgres:troque-esta-senha-forte@postgres:5432/casino_aggregator
REDIS_URL=redis://redis:6379

JWT_SECRET=troque-para-um-segredo-longo-aleatorio-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=troque-esta-chave-admin

GAMES_DIR=./games

# Domínio público DESTE aggregator (Node :3010), não o front uni_cliente
PUBLIC_BASE_URL=https://rggames.site
SALSA_PUBLISHER_URL=https://rggames.site/api/v1/salsa/publisher
# Se o cliente no admin ainda tiver wallet localhost, o aggregator usa esta URL.
BACK_UNI_WALLET_URL=https://b.sorteiobr.com/api/casino/wallet

# ── Salsa Gator PRODUÇÃO ────────────────────────────────────────────
SALSA_ENABLED=true
# Peça à Salsa o PN de produção (não use rg-games-staging aqui)
SALSA_PN=
SALSA_HASH_KEY=
SALSA_GAME_LIST_URL=https://back.patagoniaentertainment.com/game-integration.do?pn=
SALSA_API_BASE=https://api.salsagator.com
SALSA_PROVIDER_SCAN_MAX=250
SALSA_GAME_LOGO=true
SALSA_DEFAULT_COST_PCT=6.5

# true só na primeira subida se o banco estiver vazio
RUN_SEED=false
